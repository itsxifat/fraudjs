# Comma-separated list of email:password pairs for Steadfast merchant accounts.
# Use multiple accounts for automatic failover if one gets rate-limited or locked.
FRAUDJS_CREDENTIALS=email1@example.com:password1,email2@example.com:password2

# Optional: master key used to encrypt stored credentials (from `addCredential`).
# If not set, a random machine-specific key is generated and saved in your OS config
# directory (~/.config/fraudjs/master.key on Linux). Without this env var, credentials
# are locked to the current machine. Set a stable value here if you want portable
# credentials across machines or need to rotate the encryption key.
# Generate a good value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FRAUDJS_SECRET=
