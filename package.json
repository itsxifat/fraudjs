{
  "name": "steadfast-fraud",
  "version": "1.0.0",
  "description": "Check customer fraud/delivery stats on Steadfast Courier (Packzy) by phone number — handles login, session cookies, multi-account failover, and 24h auto-refresh automatically.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "fraudjs": "bin/fraudjs.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "steadfast",
    "packzy",
    "courier",
    "fraud",
    "delivery",
    "bangladesh",
    "ecommerce",
    "logistics"
  ],
  "author": {
    "name": "Sifat Hosen",
    "email": "itsxifat22@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsxifat/fraudjs.git"
  },
  "homepage": "https://github.com/itsxifat/fraudjs#readme",
  "bugs": {
    "url": "https://github.com/itsxifat/fraudjs/issues"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "env-paths": "^3.0.0",
    "tough-cookie": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
